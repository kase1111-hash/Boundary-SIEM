# Boundary SIEM ingest service (siem-ingest)
#
# Install:
#   useradd -r -s /sbin/nologin boundary-siem
#   install -m 0755 bin/siem-ingest /usr/local/bin/siem-ingest
#   install -d -m 0755 /etc/boundary-siem
#   install -m 0640 -g boundary-siem configs/config.yaml /etc/boundary-siem/config.yaml
#   install -d /var/lib/boundary-siem/rules && cp rules/*.yaml /var/lib/boundary-siem/rules/
#   printf 'SIEM_API_KEY=...\nCLICKHOUSE_PASSWORD=...\n' > /etc/boundary-siem/siem.env
#   chmod 0600 /etc/boundary-siem/siem.env
#   cp boundary-siem.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now boundary-siem
#
# siem-ingest takes no flags. It reads SIEM_CONFIG_PATH and resolves the
# relative paths in the config (rules/, data/rules, certs/) from its working
# directory, /var/lib/boundary-siem.

[Unit]
Description=Boundary SIEM Security Information and Event Management
Documentation=https://github.com/kase1111-hash/Boundary-SIEM
After=network-online.target
After=boundary-siem-firewall.service
Wants=network-online.target
Wants=boundary-siem-firewall.service

# Start after security policies are loaded
After=apparmor.service selinux-policy-migrate-local-changes@targeted.service

# If we crash, make sure to notify admin
OnFailure=boundary-siem-failure@%n.service

# Maximum restart attempts (10 in 5 minutes)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec

# Main executable
ExecStart=/usr/local/bin/siem-ingest
WorkingDirectory=/var/lib/boundary-siem

# Configuration and secrets (SIEM_API_KEY, CLICKHOUSE_PASSWORD, ...)
Environment=SIEM_CONFIG_PATH=/etc/boundary-siem/config.yaml
EnvironmentFile=-/etc/boundary-siem/siem.env

# SIGTERM drains accepted events and exits within server.shutdown_timeout (8s)
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart on failure (for example ClickHouse unreachable at startup)
Restart=always
RestartSec=5
RestartPreventExitStatus=SIGTERM SIGINT

# =====================================================
# PROCESS PROTECTION
# =====================================================

# Run as dedicated user (create with: useradd -r -s /sbin/nologin boundary-siem)
User=boundary-siem
Group=boundary-siem

# Protect against OOM killer - prefer killing other processes
OOMScoreAdjust=-900

# Memory limits
MemoryMax=2G
MemoryHigh=1G

# CPU limits to prevent runaway
CPUQuota=200%

# =====================================================
# SECURITY HARDENING
# =====================================================

# Filesystem protection
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Writable directories (StateDirectory/LogsDirectory below are writable too)
ReadWritePaths=/var/lib/boundary-siem /var/log/boundary-siem

# Network namespace (use host network for SIEM)
PrivateNetwork=no

# Restrict address families
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# No new privileges after exec
NoNewPrivileges=yes

# Capability restrictions: only needed to bind ports below 1024
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Seccomp filter; blocked calls fail with EPERM instead of killing the process
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# Restrict realtime and memory locking
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes

# Umask
UMask=0027

# =====================================================
# RUNTIME DIRECTORIES
# =====================================================

StateDirectory=boundary-siem
StateDirectoryMode=0750
LogsDirectory=boundary-siem
LogsDirectoryMode=0750
# Owned by root (systemd does not chown it); the service user reads config.yaml
# through its group, siem.env is read by systemd itself
ConfigurationDirectory=boundary-siem
ConfigurationDirectoryMode=0755

# =====================================================
# LOGGING
# =====================================================

# siem-ingest logs JSON to stdout
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boundary-siem

[Install]
WantedBy=multi-user.target

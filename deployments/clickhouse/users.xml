<clickhouse>
    <!--
      The SIEM user is created by the image from CLICKHOUSE_USER and
      CLICKHOUSE_PASSWORD (see docker-compose.yaml); no passwords live here.
      siem-ingest connects as that user (CLICKHOUSE_USER / CLICKHOUSE_PASSWORD),
      creates the database and runs its migrations.
    -->
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
        </default>
    </profiles>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
